    "metalness": {
      "type": "float",
      "default": 0.0,
      "range": [
        0.0,
        1.0
      ],
      "group": "base",
      "widget": "slider",
      "semantic": "metalness",
      "colour_space": "raw",
      "overridable": true,
      "tier": 1,
      "hosts": {},
      "doc": "materialMetalness; the metalness map's green channel."

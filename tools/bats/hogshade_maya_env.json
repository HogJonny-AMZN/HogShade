{
  "name": "HogShade maya worker environment",
  "description": "Generated by tools/bats/make_profile.py from the canon base and maya environments plus the HogShade root; the orchestrator applies no inheritance to a direct environment file, so the base is folded in here. Never hand-edited.",
  "environment": {
    "variables": {
      "JOB_ORCHESTRATOR_ROOT": "${WORKSPACE_ROOT}",
      "JOB_ORCHESTRATOR_CONFIG": "${WORKSPACE_ROOT}\\job_orchestrator\\config",
      "JOB_ORCHESTRATOR_LOGS": "${WORKSPACE_ROOT}\\logs",
      "PYTHONDONTWRITEBYTECODE": "1",
      "PYTHONUNBUFFERED": "1",
      "MAYA_DISABLE_CIP": "1",
      "MAYA_DISABLE_CER": "1",
      "MAYA_DISABLE_CLIC_IPM": "1",
      "MAYA_NO_CONSOLE_WINDOW": "0",
      "MAYA_PYTHON_VERSION": "3.11.9",
      "MAYA_SCRIPT_PATH": "${WORKSPACE_ROOT}\\job_orchestrator\\dcc_workers\\maya\\Scripts",
      "JOB_ORCHESTRATOR_MODE": "AUTO_DETECT",
      "HOGSHADE_ROOT": "D:/Depot/HogShade",
      "MAYA_VP2_DEVICE_OVERRIDE": "VirtualDeviceDx11"
    },
    "PATH": {
      "prepend": [
        "C:\\Program Files\\Autodesk\\Maya2026\\bin"
      ],
      "append": []
    },
    "PYTHONPATH": {
      "prepend": [
        "D:/Depot/HogShade",
        "${JOB_ORCHESTRATOR_ROOT}",
        "${JOB_ORCHESTRATOR_ROOT}\\job_orchestrator",
        "${WORKSPACE_ROOT}\\job_orchestrator\\dcc_workers\\maya\\Scripts",
        "${WORKSPACE_ROOT}\\job_orchestrator\\vendor",
        "${WORKSPACE_ROOT}\\shared\\maya\\Python-3.11.9\\Lib\\site-packages",
        "C:\\Program Files\\Autodesk\\Maya2026\\Python\\lib\\site-packages"
      ],
      "append": []
    }
  }
}

{
  "name": "HogShade marmoset worker environment",
  "description": "Generated by tools/bats/make_profile.py from the canon base and python environments plus the HogShade root; the orchestrator applies no inheritance to a direct environment file, so the base is folded in here. Never hand-edited.",
  "environment": {
    "variables": {
      "JOB_ORCHESTRATOR_ROOT": "${WORKSPACE_ROOT}",
      "JOB_ORCHESTRATOR_CONFIG": "${WORKSPACE_ROOT}\\job_orchestrator\\config",
      "JOB_ORCHESTRATOR_LOGS": "${WORKSPACE_ROOT}\\logs",
      "PYTHONDONTWRITEBYTECODE": "1",
      "PYTHONUNBUFFERED": "1",
      "ORCHESTRATOR_HOST": "localhost",
      "ORCHESTRATOR_PORT": "50051",
      "GLOBAL_LOGLEVEL": "INFO",
      "GLOBAL_DEBUG": "False",
      "HOGSHADE_ROOT": "D:/Depot/HogShade"
    },
    "PATH": {
      "prepend": [],
      "append": []
    },
    "PYTHONPATH": {
      "prepend": [
        "D:/Depot/HogShade",
        "${JOB_ORCHESTRATOR_ROOT}",
        "${JOB_ORCHESTRATOR_ROOT}\\job_orchestrator",
        "${WORKSPACE_ROOT}",
        "${WORKSPACE_ROOT}\\job_orchestrator\\vendor"
      ],
      "append": []
    }
  }
}

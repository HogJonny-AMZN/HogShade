// HogShade: launch tools/maya/ibl_check.py inside a Maya GUI session. See that file for the environment variables.
// The launcher itself logs and quits on any import error, so a broken script never leaves Maya open.
// The log path names maya-2026 by hand: _session (the source of that name) is what failed to import.
python("import os, sys, traceback\nroot = os.environ.get('HOGSHADE_ROOT', os.getcwd())\nsys.path.insert(0, os.path.join(root, 'tools', 'maya'))\ntry:\n    import ibl_check\nexcept Exception:\n    os.makedirs(os.path.join(root, 'verification', 'maya-2026'), exist_ok=True)\n    open(os.path.join(root, 'verification', 'maya-2026', 'launcher-error.log'), 'w').write(traceback.format_exc())\n    import maya.cmds as c\n    c.evalDeferred('import maya.cmds as c; c.quit(force=True)', lowestPriority=True)\n");
